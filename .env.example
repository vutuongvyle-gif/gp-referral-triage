# ---- Agent model (local, free) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Judge model for DeepEval ----
# gemini (free tier) or ollama
JUDGE_PROVIDER=gemini
GEMINI_API_KEY=
# Copy the current Flash-Lite model ID from Google AI Studio
GEMINI_MODEL=
JUDGE_OLLAMA_MODEL=llama3.1:8b

# ---- Optional ----
ANTHROPIC_API_KEY=

# ---- Services ----
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
FHIR_BASE_URL=http://localhost:8080/fhir
CHROMA_DIR=./data/chroma
MCP_HOST=127.0.0.1
MCP_PORT=8765
CRITIC_HOST=127.0.0.1
CRITIC_PORT=9105
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
DEEPEVAL_TELEMETRY_OPT_OUT=1